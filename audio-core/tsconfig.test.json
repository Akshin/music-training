// Type-checks the core together with its tests and signal generators.
// Same compiler rules as tsconfig.core.json; test files import `vitest` explicitly (no globals).
{
  "extends": "./tsconfig.core.json",
  "include": ["core/**/*.ts"],
  "exclude": [],
  "compilerOptions": {
    "tsBuildInfoFile": "../node_modules/.tmp/tsconfig.audio-core.test.tsbuildinfo",
    // Tests run under Node (structuredClone, performance...). Production core code is still
    // checked without any host types by tsconfig.core.json.
    "types": ["node"]
  }
}
